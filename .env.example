# Copy this file to .env and paste your real values (e.g. from Vercel).
# Required for the app to run. Never commit .env to git.

# PostgreSQL (Neon, Vercel Postgres, or any Postgres).
# From Vercel: copy DATABASE_URL from Project → Settings → Environment Variables.
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# JWT secret for login (copy from Vercel or generate a long random string).
JWT_SECRET="your-secret-at-least-32-chars"
