generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SchoolConfig {
  id                  String     @id @default(uuid())
  schoolName          String
  schoolType          SchoolType
  offersNursery       Boolean    @default(false)
  offersPrimary       Boolean    @default(false)
  offersSecondary     Boolean    @default(false)
  motto               String?
  address             String?
  logoUrl             String?
  website             String?
  currentTerm         String
  academicYear        String
  useGPA              Boolean    @default(false)
  currency            String     @default("NGN")
  isSetupDone         Boolean    @default(false)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  accountName         String?
  accountNumber       String?
  bankName            String?
  paymentInstructions String?
  email               String?
  phone               String?
}

model AcademicSession {
  id        String   @id @default(uuid())
  code      String   @unique
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
enum StudentStatus {
  ACTIVE
  PROMOTED
  GRADUATED
  WITHDRAWN
  REPEATING
}

model User {
  id                    String         @id @default(uuid())
  email                 String         @unique
  passwordHash          String
  role                  UserRole
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  passwordResetRequired Boolean        @default(true)
  deletedAt             DateTime?
  notifications         Notification[]
  parent                Parent?
  student               Student?
  teacher               Teacher?
}
model PromotionHistory {
  id              String   @id @default(uuid())
  studentId       String
  fromLevelId     String?
  toLevelId       String
  fromClassId     String?
  toClassId       String
  academicYear    String   // The NEW academic year they are promoted into
  promotedAt      DateTime @default(now())
  
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Student {
  id                String              @id @default(uuid())
  userId            String              @unique
  fullName          String
  matricNumber      String?             @unique
  dateOfBirth       DateTime?
  contactPhone      String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  levelId           String?
  departmentId      String?
  deletedAt         DateTime?
  enrollments       Enrollment[]
  invoices          Invoice[]
  status            StudentStatus       @default(ACTIVE) // Add this
  promotionHistory  PromotionHistory[] 
  parents           ParentStudentLink[]
  results           Result[]
  department        Department?         @relation(fields: [departmentId], references: [id])
  level             Level?              @relation(fields: [levelId], references: [id])
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentAttendance StudentAttendance[]

  @@index([levelId])
  @@index([fullName])
}

model Teacher {
  id               String            @id @default(uuid())
  userId           String            @unique
  fullName         String
  contactPhone     String?
  departmentId     String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  staffId          String            @unique
  classAssignments ClassAssignment[]
  department       Department?       @relation(fields: [departmentId], references: [id])
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  timetableSlots   TimetableSlot[]
}

model Parent {
  id           String              @id @default(uuid())
  userId       String              @unique
  fullName     String
  contactPhone String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  deletedAt    DateTime?
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  students     ParentStudentLink[]
}

model ParentStudentLink {
  parentId  String
  studentId String
  parent    Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([parentId, studentId])
}

model Faculty {
  id          String       @id @default(uuid())
  name        String       @unique
  description String?
  departments Department[]
}

model Department {
  id        String    @id @default(uuid())
  name      String    @unique
  facultyId String?
  classes   Class[]
  courses   Course[]
  faculty   Faculty?  @relation(fields: [facultyId], references: [id])
  students  Student[]
  teachers  Teacher[]
}

model Level {
  id           String        @id @default(uuid())
  name         String        @unique
  classes      Class[]
  courses      Course[]
  feeTemplates FeeTemplate[]
  students     Student[]
}

model Venue {
  id             String          @id @default(uuid())
  name           String          @unique
  capacity       Int
  resources      String?
  examSchedules  ExamSchedule[]
  timetableSlots TimetableSlot[]
}

model Class {
  id                String              @id @default(uuid())
  name              String
  levelId           String
  departmentId      String?
  department        Department?         @relation(fields: [departmentId], references: [id])
  level             Level               @relation(fields: [levelId], references: [id], onDelete: Cascade)
  classAssignments  ClassAssignment[]
  enrollments       Enrollment[]
  examSchedules     ExamSchedule[]
  studentAttendance StudentAttendance[]
  timetableSlots    TimetableSlot[]

  @@unique([levelId, name])
}

model Course {
  id                String              @id @default(uuid())
  name              String
  code              String?
  units             Int                 @default(1)
  description       String?
  syllabusUrl       String?
  topics            Json?
  levelId           String?
  departmentId      String?
  classAssignments  ClassAssignment[]
  department        Department?         @relation(fields: [departmentId], references: [id])
  level             Level?              @relation(fields: [levelId], references: [id])
  examSchedules     ExamSchedule[]
  results           Result[]
  studentAttendance StudentAttendance[]
  timetableSlots    TimetableSlot[]
}

model Enrollment {
  id           String  @id @default(uuid())
  studentId    String
  classId      String
  academicYear String
  class        Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  student      Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, classId, academicYear])
}

model ClassAssignment {
  id        String  @id @default(uuid())
  teacherId String
  classId   String
  courseId  String?
  class     Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  course    Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, classId, courseId])
}

model TimetableSlot {
  id        String    @id @default(uuid())
  classId   String
  courseId  String?
  teacherId String?
  venueId   String?
  day       DayOfWeek
  startTime String
  endTime   String
  type      String    @default("LESSON")
  class     Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  course    Course?   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher   Teacher?  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  venue     Venue?    @relation(fields: [venueId], references: [id])

  @@index([classId, day])
}

model StudentAttendance {
  id             String           @id @default(uuid())
  studentId      String
  courseId       String
  classId        String
  attendanceDate DateTime         @db.Date
  status         AttendanceStatus
  remarks        String?
  class          Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  course         Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student        Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId, attendanceDate])
}

model Exam {
  id            String         @id @default(uuid())
  name          String
  academicYear  String
  startDate     DateTime?
  endDate       DateTime?
  examSchedules ExamSchedule[]
  results       Result[]
}

model ExamSchedule {
  id              String   @id @default(uuid())
  examId          String
  classId         String
  courseId        String
  venueId         String?
  examDate        DateTime
  durationMinutes Int
  class           Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  exam            Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  venue           Venue?   @relation(fields: [venueId], references: [id])
}

model Result {
  id         String   @id @default(uuid())
  studentId  String
  examId     String
  courseId   String
  caScore    Decimal? @db.Decimal(5, 2)
  examScore  Decimal? @db.Decimal(5, 2)
  totalScore Decimal  @db.Decimal(5, 2)
  grade      String?
  remark     String?
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  exam       Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, examId, courseId])
}

model Invoice {
  id            String        @id @default(uuid())
  studentId     String
  invoiceNumber String        @unique
  issueDate     DateTime      @db.Date
  dueDate       DateTime      @db.Date
  totalAmount   Decimal       @db.Decimal(10, 2)
  amountPaid    Decimal       @default(0) @db.Decimal(10, 2)
  status        InvoiceStatus @default(PENDING)
  student       Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  invoiceItems  InvoiceItem[]
  payments      Payment[]
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  description String
  amount      Decimal @db.Decimal(10, 2)
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Payment {
  id            String   @id @default(uuid())
  invoiceId     String
  paymentDate   DateTime @db.Date
  amountPaid    Decimal  @db.Decimal(10, 2)
  paymentMethod String?
  reference     String?
  status        String   @default("PENDING")
  recordedBy    String?
  createdAt     DateTime @default(now())
  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model FeeTemplate {
  id           String            @id @default(uuid())
  description  String
  levelId      String
  academicYear String
  totalAmount  Decimal           @db.Decimal(10, 2)
  level        Level             @relation(fields: [levelId], references: [id])
  items        FeeTemplateItem[]
}

model FeeTemplateItem {
  id            String      @id @default(uuid())
  feeTemplateId String
  description   String
  amount        Decimal     @db.Decimal(10, 2)
  template      FeeTemplate @relation(fields: [feeTemplateId], references: [id], onDelete: Cascade)
}

model Event {
  id          String   @id @default(uuid())
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime
  venueId     String?
  audience    String   @default("ALL")
  category    String   @default("GENERAL")
  createdAt   DateTime @default(now())
  location    String?
  updatedAt   DateTime @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum SchoolType {
  BASIC
  TERTIARY
}

enum UserRole {
  ADMIN
  TEACHER
  STUDENT
  PARENT
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
  PARTIALLY_PAID
}
